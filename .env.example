# Backend API & Server Configuration
PROJECT_NAME="The Lenny Growth Assistant"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Local Docker Postgres: postgresql://postgres:postgres@localhost:5432/lenny_growth_db
# Cloud Supabase Postgres: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lenny_growth_db"

# LLM Providers Configuration
# Mandatory Local Model (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_OLLAMA_MODEL="llama3"

# Cloud Provider (Anthropic Claude)
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-your-key-here"
DEFAULT_ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# RAG & Embedding Settings
EMBEDDING_MODEL_DIM=384
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_RETRIEVAL_CHUNKS=4

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
